# Copy this file to .env and change the values.
# Never commit the real .env file.

# Password for the web UI (required, at least 8 characters)
APP_PASSWORD=change-me-to-a-long-password

# Optional: fixed key for login cookies. Leave empty to generate one at each start
# (you will just need to log in again after a restart).
SESSION_SECRET=

# Port on your server that maps to the app
HOST_PORT=8080

# Largest single file allowed, in MB
MAX_UPLOAD_MB=5120

# Set to 1 when the site is served over HTTPS (recommended)
COOKIE_SECURE=0

# Hours before you have to log in again
SESSION_TTL_HOURS=12
