# Copy this file to .env and change the values.
# Never commit the real .env file.

# Password for the web UI (required, at least 8 characters)
APP_PASSWORD=change-me-to-a-long-password

# Folder on the server where files are stored. Pick a disk with plenty of free space.
# Must be writable by user ID 1000 (see README). Leave empty to use a Docker volume.
DATA_PATH=/srv/filestore

# Optional: fixed key for login cookies. Leave empty to generate one at each start.
SESSION_SECRET=

# Only for running on your own machine: open the app at http://localhost:<HOST_PORT>.
# Leave empty on Coolify (it routes traffic itself).
HOST_PORT=8090

# Largest single file in GB. 0 = no limit (only free disk space applies)
MAX_FILE_GB=0

# Upload part size in MB. 64 is a good default; keep below 100
CHUNK_MB=64

# Only if you want uploads refused when the disk is nearly full.
# Free space to keep on the disk after an upload is accepted, in GB. 0 = don't check
DISK_RESERVE_GB=0

# Set to 1 when the site is served over HTTPS (recommended)
COOKIE_SECURE=0

# Logged out after this many idle hours. Active uploads keep the login alive.
SESSION_TTL_HOURS=12
